// Development tool: bakes the score glyphs of a pixel font into Odin source,
// so the baseline starter can draw them without SDL_ttf or a font file.
//
// Usage: scripts/bake-score-font.sh   (needs scripts/bootstrap.sh --with-text)
//        bake-score-font <font.ttf> <out.odin>
//
// Each glyph is rendered with SDL_ttf's 1-bit "Solid" renderer and written as
// rows of '#' (ink) and '.' (empty). Rows that are empty in every glyph are
// trimmed from the top and bottom.
package bake_score_font

import "core:fmt"
import "core:os"
import "core:path/filepath"
import "core:strings"
import sdl "vendor:sdl3"
import ttf "vendor:sdl3/ttf"

// Characters the score display needs. Keep in sync with what render draws.
CHARSET :: "SCORE 0123456789"

// Jersey 10 is drawn on a 75-unit pixel grid in a 1400-unit em, so this size
// puts exactly one font pixel on one output pixel (10 pixel cap height).
PIXEL_SIZE :: 1400.0 / 75.0

Glyph :: struct {
	char:    rune,
	advance: int,
	rows:    [dynamic]string,
}

main :: proc() {
	if len(os.args) != 3 {
		fmt.eprintln("usage: bake-score-font <font.ttf> <out.odin>")
		os.exit(2)
	}
	font_path, out_path := os.args[1], os.args[2]

	if !ttf.Init() do fail("TTF_Init")
	defer ttf.Quit()
	font := ttf.OpenFont(strings.clone_to_cstring(font_path), PIXEL_SIZE)
	if font == nil do fail("OpenFont")
	defer ttf.CloseFont(font)
	ttf.SetFontHinting(font, .MONO)

	glyphs: [dynamic]Glyph
	height := -1
	for ch in CHARSET {
		if glyph_index(glyphs[:], ch) >= 0 do continue
		glyph := Glyph{char = ch}
		advance: i32
		if !ttf.GetGlyphMetrics(font, u32(ch), nil, nil, nil, nil, &advance) do fail("GetGlyphMetrics")
		glyph.advance = int(advance)

		text := fmt.tprint(ch)
		surface := ttf.RenderText_Solid(font, raw_data(text), len(text), {255, 255, 255, 255})
		if surface == nil do fail("RenderText_Solid")
		defer sdl.DestroySurface(surface)
		// Solid surfaces are 8-bit palettized: index 0 is transparent, other indices are ink.
		assert(surface.format == .INDEX8)
		if height < 0 do height = int(surface.h)
		assert(int(surface.h) == height, "glyph surfaces differ in height")

		pixels := ([^]u8)(surface.pixels)
		for y in 0 ..< int(surface.h) {
			row := strings.builder_make()
			for x in 0 ..< glyph.advance {
				ink := x < int(surface.w) && pixels[y * int(surface.pitch) + x] != 0
				strings.write_byte(&row, '#' if ink else '.')
			}
			append(&glyph.rows, strings.to_string(row))
		}
		append(&glyphs, glyph)
	}

	// Trim rows that are empty in every glyph.
	top, bottom := height, 0
	for g in glyphs {
		for row, y in g.rows {
			if strings.contains_rune(row, '#') {
				top = min(top, y)
				bottom = max(bottom, y + 1)
			}
		}
	}
	assert(top < bottom, "no glyph has any ink")

	b := strings.builder_make()
	fmt.sbprintfln(&b, "// Code generated by tools/bake-score-font from assets/fonts/%s; DO NOT EDIT.", filepath.base(font_path))
	fmt.sbprintln(&b, "// Regenerate with scripts/bake-score-font.sh. Font license (SIL OFL 1.1):")
	fmt.sbprintln(&b, "// assets/fonts/Jersey10-OFL.txt.")
	fmt.sbprintln(&b, "package main")
	fmt.sbprintln(&b)
	fmt.sbprintfln(&b, "SCORE_FONT_HEIGHT :: %d", bottom - top)
	fmt.sbprintln(&b)
	fmt.sbprintln(&b, "SCORE_FONT_GLYPHS := [?]Score_Glyph{")
	for g in glyphs {
		fmt.sbprintfln(&b, "\t{{%q, %d, {{", g.char, g.advance)
		for row in g.rows[top:bottom] {
			fmt.sbprintfln(&b, "\t\t%q,", row)
		}
		fmt.sbprintln(&b, "\t}},")
	}
	fmt.sbprintln(&b, "}")

	if err := os.write_entire_file(out_path, strings.to_string(b)); err != nil {
		fmt.eprintfln("error: writing %s: %v", out_path, err)
		os.exit(1)
	}
	fmt.printfln("baked %d glyphs (%d rows) from %s into %s", len(glyphs), bottom - top, font_path, out_path)
}

glyph_index :: proc(glyphs: []Glyph, ch: rune) -> int {
	for g, i in glyphs {
		if g.char == ch do return i
	}
	return -1
}

fail :: proc(what: string) -> ! {
	fmt.eprintfln("error: %s failed: %s", what, sdl.GetError())
	os.exit(1)
}
