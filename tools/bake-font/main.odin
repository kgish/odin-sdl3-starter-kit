// Development tool: bakes glyphs of a pixel font into Odin source, so the
// baseline starter can draw them without SDL_ttf or a font file.
//
// Usage: scripts/bake-fonts.sh   (needs scripts/bootstrap.sh --with-text)
//        bake-font <font.ttf> <em>/<grid> <charset> <NAME> <out.odin>
//
// <em>/<grid> is the font's units per em over its units per font pixel; the
// font is rendered at that many pixels per em, so one font pixel lands on
// exactly one output pixel. <NAME> prefixes the generated declaration
// (<NAME>_GLYPHS).
//
// Each glyph is rendered with SDL_ttf's 1-bit "Solid" renderer and written as
// rows of '#' (ink) and '.' (empty), with its left edge in the atlas that
// src/baked_font.odin builds from it. Rows that are empty in every glyph are
// trimmed from the top and bottom.
package bake_font

import "core:fmt"
import "core:os"
import "core:path/filepath"
import "core:strconv"
import "core:strings"
import sdl "vendor:sdl3"
import ttf "vendor:sdl3/ttf"

Glyph :: struct {
	char:    rune,
	advance: int,
	rows:    [dynamic]string,
}

main :: proc() {
	if len(os.args) != 6 {
		fmt.eprintln("usage: bake-font <font.ttf> <em>/<grid> <charset> <NAME> <out.odin>")
		os.exit(2)
	}
	font_path, size_arg, charset, name, out_path := os.args[1], os.args[2], os.args[3], os.args[4], os.args[5]
	em, _, grid := strings.partition(size_arg, "/")
	em_units, ok1 := strconv.parse_f32(em)
	grid_units, ok2 := strconv.parse_f32(grid)
	if !ok1 || !ok2 || grid_units <= 0 {
		fmt.eprintfln("error: size must be <em>/<grid>, e.g. 1400/75; got %q", size_arg)
		os.exit(2)
	}

	if !ttf.Init() do fail("TTF_Init")
	defer ttf.Quit()
	font := ttf.OpenFont(strings.clone_to_cstring(font_path), em_units / grid_units)
	if font == nil do fail("OpenFont")
	defer ttf.CloseFont(font)
	ttf.SetFontHinting(font, .MONO)

	glyphs: [dynamic]Glyph
	height := -1
	for ch in charset {
		if glyph_index(glyphs[:], ch) >= 0 do continue
		if !ttf.FontHasGlyph(font, u32(ch)) {
			fmt.eprintfln("error: %s has no glyph for %q", font_path, ch)
			os.exit(1)
		}
		glyph := Glyph{char = ch}
		advance: i32
		if !ttf.GetGlyphMetrics(font, u32(ch), nil, nil, nil, nil, &advance) do fail("GetGlyphMetrics")
		glyph.advance = int(advance)

		text := fmt.tprint(ch)
		surface := ttf.RenderText_Solid(font, raw_data(text), len(text), {255, 255, 255, 255})
		if surface == nil do fail("RenderText_Solid")
		defer sdl.DestroySurface(surface)
		// Solid surfaces are 8-bit palettized: index 0 is transparent, other indices are ink.
		assert(surface.format == .INDEX8)
		if height < 0 do height = int(surface.h)
		assert(int(surface.h) == height, "glyph surfaces differ in height")

		pixels := ([^]u8)(surface.pixels)
		for y in 0 ..< int(surface.h) {
			row := strings.builder_make()
			for x in 0 ..< glyph.advance {
				ink := x < int(surface.w) && pixels[y * int(surface.pitch) + x] != 0
				strings.write_byte(&row, '#' if ink else '.')
			}
			append(&glyph.rows, strings.to_string(row))
		}
		append(&glyphs, glyph)
	}

	// Trim rows that are empty in every glyph.
	top, bottom := height, 0
	for g in glyphs {
		for row, y in g.rows {
			if strings.contains_rune(row, '#') {
				top = min(top, y)
				bottom = max(bottom, y + 1)
			}
		}
	}
	assert(top < bottom, "no glyph has any ink")

	font_file := filepath.base(font_path)
	license := fmt.tprintf("%s-OFL.txt", strings.split(font_file, "-")[0])
	b := strings.builder_make()
	fmt.sbprintfln(&b, "// Code generated by tools/bake-font from assets/fonts/%s; DO NOT EDIT.", font_file)
	fmt.sbprintln(&b, "// Regenerate with scripts/bake-fonts.sh. Font license (SIL OFL 1.1):")
	fmt.sbprintfln(&b, "// assets/fonts/%s.", license)
	fmt.sbprintln(&b, "package main")
	fmt.sbprintln(&b)
	fmt.sbprintln(&b, "// {char, x in atlas, advance, rows}")
	fmt.sbprintfln(&b, "%s_GLYPHS := []Baked_Glyph{{", name)
	x := 0
	for g in glyphs {
		fmt.sbprintfln(&b, "\t{{%q, %d, %d, {{", g.char, x, g.advance)
		for row in g.rows[top:bottom] {
			fmt.sbprintfln(&b, "\t\t%q,", row)
		}
		fmt.sbprintln(&b, "\t}},")
		x += g.advance
	}
	fmt.sbprintln(&b, "}")

	if err := os.write_entire_file(out_path, strings.to_string(b)); err != nil {
		fmt.eprintfln("error: writing %s: %v", out_path, err)
		os.exit(1)
	}
	fmt.printfln("baked %d glyphs (%d rows) from %s into %s", len(glyphs), bottom - top, font_file, out_path)
}

glyph_index :: proc(glyphs: []Glyph, ch: rune) -> int {
	for g, i in glyphs {
		if g.char == ch do return i
	}
	return -1
}

fail :: proc(what: string) -> ! {
	fmt.eprintfln("error: %s failed: %s", what, sdl.GetError())
	os.exit(1)
}
